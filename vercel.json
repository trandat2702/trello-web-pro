{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://trello-api-h1dj.onrender.com/:path*"
        },
        {
            "source": "/socket.io/:path*",
            "destination": "https://trello-api-h1dj.onrender.com/socket.io/:path*"
        },
        {
            "source": "/((?!.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}